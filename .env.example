# Copy to `.env` for local Docker development. Never commit `.env` or real secrets.
# Only non-secret names live here; values are local dev defaults.

# PostgreSQL (Compose `db` service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mini_ecommerce_development
POSTGRES_PORT=5432

# Rails
RAILS_ENV=development
RAILS_MAX_THREADS=5
PORT=3000

# Rails credentials master key (required to boot when credentials are used).
# Paste the value from config/master.key here for Docker, or leave blank if unused.
# Get it with: docker compose run --rm web cat config/master.key
RAILS_MASTER_KEY=
